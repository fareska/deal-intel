POSTGRES_USER=deal
POSTGRES_PASSWORD=change-me
POSTGRES_DB=deal_intel
DATABASE_URL=postgresql+psycopg://deal:change-me@localhost:5432/deal_intel
TEST_DATABASE_URL=postgresql+psycopg://deal:change-me@localhost:5432/deal_intel_test

# Export ANTHROPIC_API_KEY in your shell rather than writing it here.
# ANTHROPIC_API_KEY=
LLM_CLIENT=anthropic
# Confirmed against the Anthropic models overview; prices live in MODEL_PRICES_USD_PER_MTOK.
MODEL_STRATEGY=claude-sonnet-4-6
MODEL_EXTRACTION=claude-haiku-4-5-20251001
STRATEGY_EFFORT=medium
MAX_TOOL_CALLS=4
RUN_INPUT_TOKEN_BUDGET=250000
DAILY_COST_BUDGET_USD=20
RECORD_FIXTURES=0

RUN_EXECUTOR_WORKERS=2
APPROVAL_EXPIRY_HOURS=168
EMBEDDINGS_ENABLED=false

APP_ENV=dev
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000
